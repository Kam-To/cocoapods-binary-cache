# 示例 Podfile - 演示如何使用 cocoapods-binary-cache-mvp 插件

# 1. 加载插件
plugin 'cocoapods-binary-cache-mvp'

# 2. 配置插件
config_binary_cache({
  # 缓存根目录
  cache_path: "_Prebuild",

  # 预编译使用的配置（Debug 或 Release）
  prebuild_config: "Debug",

  # Artifact 哈希计算因子
  # 可选因子: :source, :dependencies, :build_settings, :compiler_flags, :deployment_target
  # 因子越少，缓存命中率越高，但精确度越低
  artifact_hash_factors: [:source, :dependencies],

  # 是否验证预编译设置（生产环境建议开启）
  validate_prebuilt_settings: false
})

# 3. 定义目标
target 'ExampleApp' do
  # 使用 frameworks（必需）
  use_frameworks!

  # 平台和版本
  platform :ios, '13.0'

  # ============================================
  # 预编译 Pods（使用二进制缓存）
  # ============================================
  # 特点：大型、稳定、编译慢的第三方库
  # 优势：显著减少编译时间

  # 网络库
  pod 'Alamofire', '~> 5.6', :binary => true

  # 响应式编程
  pod 'RxSwift', '~> 6.5', :binary => true
  pod 'RxCocoa', '~> 6.5', :binary => true

  # 自动布局
  pod 'SnapKit', '~> 5.0', :binary => true

  # 图片加载
  pod 'Kingfisher', '~> 7.0', :binary => true

  # ============================================
  # 普通 Pods（不使用缓存）
  # ============================================
  # 特点：小型、频繁修改、编译快的库
  # 或者：项目内部模块、开发中的库

  # JSON 解析（轻量级，不需要预编译）
  pod 'SwiftyJSON'

  # 日志库（经常修改配置）
  # pod 'CocoaLumberjack'

  # 本地开发的 Pod（不应该预编译）
  # pod 'MyLocalModule', :path => '../MyLocalModule'
end

# ============================================
# 使用说明
# ============================================
#
# 1. 首次使用或更新 Pod 后，执行预编译：
#    $ pod binary prebuild
#
#    这会：
#    - 分析 Podfile.lock
#    - 计算每个 :binary => true 的 Pod 的 Artifact ID
#    - 检查缓存是否存在
#    - 编译缺失的 Pods 并缓存
#
# 2. 日常开发，直接执行 pod install：
#    $ pod install
#
#    这会：
#    - 自动使用已缓存的二进制框架
#    - 显著减少编译时间
#
# 3. 清理缓存（可选）：
#    $ pod binary clean
#
# 4. 使用不同的构建配置：
#    $ pod binary prebuild --config=Release
#
# ============================================
# 最佳实践
# ============================================
#
# 1. 选择性预编译
#    - ✅ 大型第三方库（Alamofire, RxSwift）
#    - ✅ 稳定不变的库（版本长期不更新）
#    - ❌ 小型库（编译时间短）
#    - ❌ 频繁修改的库（缓存命中率低）
#    - ❌ 项目内部模块（开发中）
#
# 2. 选择合适的 hash_factors
#    - 开发环境：[:source, :dependencies] - 快速迭代
#    - CI 环境：[:source, :dependencies, :build_settings] - 平衡
#    - 生产构建：所有因子 - 最精确
#
# 3. 团队协作
#    - 将 _Prebuild/artifacts/ 目录加入 .gitignore
#    - 在 CI 上执行 pod binary prebuild
#    - 团队成员共享 CI 生成的缓存（可选）
#
# 4. 版本更新
#    - 更新 Pod 版本后，执行 pod binary prebuild
#    - 插件会自动检测版本变化并重新编译
#
