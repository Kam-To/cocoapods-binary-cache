platform :ios, '13.0'

install! 'cocoapods',
:generate_multiple_pod_projects => true

plugin 'cocoapods-binary-cache'
config_cocoapods_binary_cache(
  cache_path: "~/.cocoapods-binary-cache/PodBinaryCacheExample-libs",
  prebuild_config: "Release",
  build_args: {
    :simulator => [
      "ARCHS='x86_64 arm64'"
    ],
    default: ["MACH_O_TYPE=staticlib"]
  },

  # Artifact-based versioning is now the only mode (always enabled)
  # Customize hash factors if needed:
  artifact_hash_factors: [:source, :dependencies, :build_settings, :compiler_flags, :deployment_target]
)




target 'PodBinCacheExample' do
  use_frameworks!
  
  pod 'AFNetworking', '3.2.1', :binary => true
#  pod 'AFNetworking', :git => 'https://git-opd.nie.netease.com/gl-ios/afnetworking.git', :tag => '2.7.2', :binary => true
  pod 'AmrCodec', :path => '../local_pod/AmrCodec', :binary => true
  pod 'SDWebImage', :binary => true
  pod 'SnapKit', :binary => true
  pod 'Kingfisher', :binary => true
end

post_install do |installer|
  # 兼容 generate_multiple_pod_projects 的配置
  # 1. 尝试使用 generated_projects（多项目模式）
  # 2. 如果为空则使用 pods_project（单项目模式）
  projects = installer.respond_to?(:generated_projects) ? installer.generated_projects : []
  projects = [installer.pods_project].compact if projects.empty?

  projects.each do |project|
    project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES' # Only work from Xcode 11

        # 安全检查：确保 IPHONEOS_DEPLOYMENT_TARGET 存在且不为空
        deployment_target = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if deployment_target && !deployment_target.to_s.empty?
          if Gem::Version.new('13.0') > Gem::Version.new(deployment_target)
            config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
          end
        else
          # 如果不存在，直接设置
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
        end
      end
    end
  end
end
